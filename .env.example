# Copy to .env.local. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.
# Only variables for IMPLEMENTED integrations are listed; others are added when built.

# ── Database (Neon) ── required for local dev
# Pooled connection string (runtime) and direct connection string (migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ── required
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Application ──
APP_URL=http://localhost:3000
STOREFRONT_BASE_DOMAIN=launchmate.example

# ── AI (provider-agnostic; no provider chosen yet) ── required for the agent
# AI_PROVIDER=openai-compatible
# AI_MODEL=
# AI_BASE_URL=
# AI_API_KEY=

# ── Celo / hackathon ──
# Public code issued at enrolment (appears in every tagged tx; not a secret)
ATTRIBUTION_CODE=celo_b02f2c0e5298
CELO_RPC_URL=https://forno.celo.org
# Agent wallet: generated by `npm run wallet:generate` into .env.local (never committed, never pasted anywhere)
# AGENT_PRIVATE_KEY=
# AGENT_WALLET_ADDRESS=
# SELF_AGENT_ID=   (set by `npm run self:register`)

# ── x402 seller (paid service) ──
# Where payments go (an address YOU control; register it at hackathon registration). Can be your existing wallet.
# X402_PAYTO_ADDRESS=
# Facilitator API key: create at https://x402.celo.org (connect wallet, sign an off-chain message). Server-side secret.
# X402_API_KEY=
# Price in USDC base units (6 decimals): 10000 = $0.01
# X402_PRICE_USDC_UNITS=10000

# ── Demo build speed (prototype build simulation only) ──
# NEXT_PUBLIC_BUILD_SPEED=1
